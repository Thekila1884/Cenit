rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn()
        && request.auth.token.active == true
        && request.auth.token.role in ['admin', 'agent', 'user']
        && request.auth.token.companyId is string
        && request.auth.token.companyId.matches('^[0-9]{10}$')
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == request.auth.token.role
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
          == request.auth.token.companyId
        && exists(/databases/$(database)/documents/companies/$(request.auth.token.companyId))
        && get(/databases/$(database)/documents/companies/$(request.auth.token.companyId)).data.active == true;
    }

    function staff() {
      return activeUser() && request.auth.token.role in ['admin', 'agent'];
    }

    function administrator() {
      return activeUser() && request.auth.token.role == 'admin';
    }

    function tenantMember(companyId) {
      return activeUser()
        && companyId is string
        && request.auth.token.companyId == companyId
        && exists(/databases/$(database)/documents/companies/$(companyId))
        && get(/databases/$(database)/documents/companies/$(companyId)).data.active == true;
    }

    function tenantStaff(companyId) {
      return staff() && tenantMember(companyId);
    }

    function defaultTicketCategories() {
      return {
        'Periféricos': {
          'Mouse': ['Dañado', 'Sin batería', 'No funciona'],
          'Teclado': ['Dañado', 'No funciona', 'Teclas no responden'],
          'Monitor': ['Dañado', 'Sin señal', 'No enciende']
        },
        'Soporte TI': {'General': ['No funciona', 'Error', 'Otro']},
        'Infraestructura': {'General': ['Sin conexión', 'Intermitente', 'Otro']},
        'Recursos humanos': {'General': ['Consulta', 'Actualización', 'Otro']},
        'Finanzas': {'General': ['Consulta', 'Otro']},
        'Mantenimiento': {'General': ['Dañado', 'No funciona', 'Otro']},
        'Otro': {'General': ['Otro']}
      };
    }

    function configuredTicketCategories(companyId) {
      let settingsPath = /databases/$(database)/documents/companySettings/$(companyId);
      return exists(settingsPath)
        ? get(settingsPath).data.ticketCategories
        : defaultTicketCategories();
    }

    function validConfiguredTicketClassification() {
      let categories = configuredTicketCategories(request.auth.token.companyId);
      let category = request.resource.data.category;
      let categoryType = request.resource.data.categoryType;
      let issue = request.resource.data.issue;
      return categories is map
        && categories.keys().hasAny([category])
        && categories[category] is map
        && categories[category].keys().hasAny([categoryType])
        && categories[category][categoryType] is list
        && categories[category][categoryType].hasAny([issue]);
    }

    function validTicketClassification() {
      return request.resource.data.keys().hasAll(['categoryType', 'issue'])
        ? request.resource.data.categoryType is string
          && request.resource.data.categoryType.size() > 0
          && request.resource.data.categoryType.size() <= 80
          && request.resource.data.issue is string
          && request.resource.data.issue.size() > 0
          && request.resource.data.issue.size() <= 80
          && validConfiguredTicketClassification()
        : !exists(/databases/$(database)/documents/companySettings/$(request.auth.token.companyId))
          && !request.resource.data.keys().hasAny(['categoryType', 'issue'])
          && request.resource.data.category in [
            'Soporte TI', 'Infraestructura', 'Recursos humanos', 'Finanzas',
            'Mantenimiento', 'Otro'
          ];
    }

    function validTicket() {
      return request.resource.data.keys().hasOnly([
          'companyId', 'title', 'description', 'category', 'categoryType', 'issue',
          'priority', 'status', 'createdBy', 'createdByName', 'assignedTo', 'createdAt',
          'dueDate', 'updatedAt', 'closedAt'
        ])
        && request.resource.data.companyId == request.auth.token.companyId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 4000
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 80
        && validTicketClassification()
        && request.resource.data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
          == request.auth.token.companyId
        && request.resource.data.createdByName
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.assignedTo == null
        && request.resource.data.closedAt == null
        && request.resource.data.dueDate is string
        && request.resource.data.dueDate.size() == 10
        && request.resource.data.status == 'abierto'
        && request.resource.data.priority in ['baja', 'media', 'alta', 'critica']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validAssignee() {
      return request.resource.data.assignedTo == null
        || (exists(/databases/$(database)/documents/users/$(request.resource.data.assignedTo))
          && get(/databases/$(database)/documents/users/$(request.resource.data.assignedTo)).data.active == true
          && get(/databases/$(database)/documents/users/$(request.resource.data.assignedTo)).data.role in ['admin', 'agent']
          && get(/databases/$(database)/documents/users/$(request.resource.data.assignedTo)).data.companyId
            == request.auth.token.companyId);
    }

    match /companies/{companyId} {
      allow get: if tenantMember(companyId);
      allow list, create, update, delete: if false;
    }

    match /companySettings/{companyId} {
      allow get: if tenantMember(companyId);
      allow list: if false;
      allow create, update: if administrator()
        && request.auth.token.companyId == companyId
        && request.resource.data.keys().hasOnly(['companyId', 'ticketCategories', 'updatedAt'])
        && request.resource.data.companyId == companyId
        && request.resource.data.ticketCategories is map
        && request.resource.data.ticketCategories.keys().size() > 0
        && request.resource.data.ticketCategories.keys().size() <= 30
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if tenantMember(resource.data.companyId)
        && (request.auth.uid == userId || staff());
      allow write: if false;
    }

    match /tickets/{ticketId} {
      allow read: if tenantStaff(resource.data.companyId)
        || (tenantMember(resource.data.companyId) && resource.data.createdBy == request.auth.uid);
      allow create: if tenantMember(request.resource.data.companyId) && validTicket();
      allow update: if tenantStaff(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'priority', 'assignedTo', 'updatedAt', 'closedAt'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['closedAt'])
          || request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (request.resource.data.status == 'resuelto'
            ? request.resource.data.closedAt == request.time
            : request.resource.data.closedAt == null))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in ['abierto', 'progreso', 'revision', 'resuelto']
        && request.resource.data.priority in ['baja', 'media', 'alta', 'critica']
        && validAssignee();
      allow delete: if administrator() && resource.data.companyId == request.auth.token.companyId;

      match /comments/{commentId} {
        function canReadParent() {
          return activeUser()
            && get(/databases/$(database)/documents/tickets/$(ticketId)).data.companyId
              == request.auth.token.companyId
            && (staff()
              || get(/databases/$(database)/documents/tickets/$(ticketId)).data.createdBy == request.auth.uid);
        }

        allow read: if canReadParent();
        allow create: if canReadParent()
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /errorReports/{reportId} {
      allow read: if administrator() && resource.data.companyId == request.auth.token.companyId;
      allow update: if administrator()
        && resource.data.companyId == request.auth.token.companyId
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus'])
        && request.resource.data.reviewStatus in ['pending', 'reviewed'];
      allow create, delete: if false;
    }

    match /errorReportRateLimits/{rateLimitId} {
      allow read, write: if false;
    }
  }
}
