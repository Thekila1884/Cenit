{
  "name": "cenit-helpdesk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "set-admin": "node --env-file=.env functions/scripts/set-admin.mjs",
    "bootstrap-company": "node --env-file=.env functions/scripts/bootstrap-company.mjs",
    "create-company-admin": "node --env-file=.env functions/scripts/create-company-admin.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "firebase deploy --only functions",
    "deploy": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^14.5.1"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
